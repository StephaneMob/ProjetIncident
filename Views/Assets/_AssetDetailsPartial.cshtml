@model CICertSOAR.Models.Asset

<div class="modal-header modal-header-gov text-white py-3">
    <h5 class="modal-header-title mb-0 fw-bold d-flex align-items-center gap-2">
        <i class="bi bi-server text-info fs-4"></i>
        Fiche CMDB Actif : @Model.Name
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body p-4">
    <div class="row g-4 mb-4">
        <!-- Asset Information -->
        <div class="col-md-6 border-end">
            <h6 class="fw-bold text-uppercase text-secondary small border-bottom pb-2 mb-3">
                <i class="bi bi-cpu me-1"></i> Caractéristiques Technologiques
            </h6>
            <table class="table table-sm table-borderless small mb-0">
                <tr>
                    <td class="text-muted fw-bold" style="width: 140px;">Nom de l'Actif :</td>
                    <td class="fw-bold text-dark">@Model.Name</td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Adresse IP :</td>
                    <td><code class="bg-light px-2 py-1 rounded text-primary fw-bold">@Model.IpAddress</code></td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Nom de Domaine :</td>
                    <td><span class="text-dark fw-bold">@Model.Domain</span></td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Type d'Actif :</td>
                    <td><span class="badge bg-light text-dark border">@Model.Type</span></td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Niveau de Criticité :</td>
                    <td><span class="badge-severity @Model.Criticality">@Model.Criticality</span></td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Date d'Enregistrement :</td>
                    <td>@Model.DateRegistered.ToString("dd/MM/yyyy à HH:mm")</td>
                </tr>
            </table>
        </div>

        <!-- Institutional Attachment -->
        <div class="col-md-6">
            <h6 class="fw-bold text-uppercase text-secondary small border-bottom pb-2 mb-3">
                <i class="bi bi-building me-1"></i> Rattachement Institutionnel & Contacts
            </h6>
            <table class="table table-sm table-borderless small mb-0">
                <tr>
                    <td class="text-muted fw-bold" style="width: 140px;">Organisation :</td>
                    <td class="fw-bold text-primary">@(Model.Organization?.Name ?? "N/A")</td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Ministère Tutelle :</td>
                    <td class="fw-bold text-dark">@(Model.Organization?.Ministry?.Name ?? "N/A")</td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Secteur National :</td>
                    <td><span class="badge bg-secondary">@(Model.Organization?.Ministry?.Sector?.Name ?? "N/A")</span></td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Nom Contact RSSI :</td>
                    <td class="fw-bold">@(Model.Organization?.ContactName ?? "N/A")</td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Courriel Notification :</td>
                    <td><a href="mailto:@(Model.Organization?.ContactEmail)" class="text-decoration-none">@(Model.Organization?.ContactEmail ?? "N/A")</a></td>
                </tr>
                <tr>
                    <td class="text-muted fw-bold">Téléphone Urgence :</td>
                    <td>@(Model.Organization?.ContactPhone ?? "N/A")</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- History of Incidents on this Asset -->
    <h6 class="fw-bold text-uppercase text-secondary small border-bottom pb-2 mb-3">
        <i class="bi bi-shield-slash me-1"></i> Historique des Incidents de Sécurité sur cet Actif (@Model.Incidents.Count)
    </h6>
    @if (!Model.Incidents.Any())
    {
        <div class="p-3 bg-light rounded text-center text-muted small">
            <i class="bi bi-check-circle text-success me-1"></i> Aucun incident de sécurité recensé à ce jour sur cet actif.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Ticket RTIR</th>
                        <th>CVE Vulnérabilité</th>
                        <th>Date Détection</th>
                        <th>Sévérité</th>
                        <th>Statut Ticket</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inc in Model.Incidents)
                    {
                        <tr>
                            <td><span class="fw-bold text-dark">@inc.TicketNumber</span></td>
                            <td><span class="badge bg-dark">@(inc.Vulnerability?.CveId ?? "N/A")</span></td>
                            <td>@inc.DateDetected.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge-severity @inc.Severity">@inc.Severity</span></td>
                            <td><span class="badge-status @inc.Status">@inc.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="modal-footer bg-light">
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
</div>
